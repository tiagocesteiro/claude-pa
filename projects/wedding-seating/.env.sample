# Wedding Seating Planner — environment contract
# ─────────────────────────────────────────────────────────────────────────────
# COPY THIS FILE TO `.env` (na pasta projects/wedding-seating/) E PREENCHE OS <...>.
# O `.env` é gitignored — segredos ficam só aqui + no Vercel. NUNCA commitar.
#   PowerShell:  Copy-Item .env.sample .env
# ─────────────────────────────────────────────────────────────────────────────

# === Base de dados (Prisma → Supabase Postgres) ===
# No dashboard Supabase: botão "Connect" → separador ORMs (ou Postgres).
# COLA as strings EXATAS de lá (já trazem o host/região e o utilizador certos);
# só substitui [YOUR-PASSWORD] pela password da DB (Settings → Database → Database password).
#   DATABASE_URL = "Transaction pooler" (porta 6543) — usado pela app em runtime
#   DIRECT_URL   = "Direct connection"  (porta 5432) — usado pelo `prisma migrate`
DATABASE_URL="<COLA a Transaction pooler string, :6543 — garante ?pgbouncer=true no fim>"
DIRECT_URL="<COLA a Direct connection string, :5432>"

# === Supabase (Storage + Auth — Fases B/C) ===
NEXT_PUBLIC_SUPABASE_URL="https://tmpgncdkvhwlgcffigqn.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon public — Settings → API → Project API keys>"
SUPABASE_SERVICE_ROLE_KEY="<service_role — Settings → API — SECRETA; usa a NOVA depois de rotacionar>"
SUPABASE_STORAGE_BUCKET="floorplans"

# === Gate temporário (até a Fase C trazer login a sério) ===
# Se definido, TODO o site (páginas + API) exige esta password via Basic Auth.
# Define-a no Vercel para manter o deploy privado. Deixa vazia/ausente em local.
# SITE_PASSWORD="<uma password à tua escolha>"

# --- (Opcional) voltar ao SQLite local antigo: comenta as 2 linhas Postgres acima e usa: ---
# DATABASE_URL="file:./dev.db"
