# Wedding Seating Planner — environment contract
# Copy to `.env` and fill in. NEVER commit real secrets.

# --- Database (Prisma) ---
# Local dev today uses SQLite: DATABASE_URL="file:./dev.db"
# Production (Supabase Postgres) — Fase A:
#   DATABASE_URL = pooled connection (PgBouncer, port 6543) — used at runtime
#   DIRECT_URL   = direct connection (port 5432) — used by `prisma migrate`
DATABASE_URL="file:./dev.db"
# DIRECT_URL="postgresql://postgres:<pwd>@db.<ref>.supabase.co:5432/postgres"

# --- Supabase (Fase B/C: Storage + Auth) ---
# NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"        # safe for the browser
# SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"    # SERVER ONLY — never expose to the client
# SUPABASE_STORAGE_BUCKET="floorplans"
