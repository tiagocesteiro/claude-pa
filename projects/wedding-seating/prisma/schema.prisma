generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; "rhel-openssl-3.0.x" for Vercel's serverless runtime (Fase A).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Mirrors a Supabase `auth.users` row (id = same uuid). Not a Prisma relation
/// to auth.users — that schema lives outside Prisma's reach. Created/upserted
/// right after signup/login (see `src/lib/db/profiles.ts`).
model Profile {
  id        String   @id // Supabase auth.users.id (uuid)
  email     String
  role      String // "venue" | "couple" | "supplier" | "admin"
  createdAt DateTime @default(now())
}

model Venue {
  id              String           @id @default(cuid())
  name            String
  location        String?
  photos          String? // JSON array of file paths
  ownerId         String? // Profile.id of the venue account — nullable until Fase D tightens + filters
  floorPlans      FloorPlan[]
  tableTypes      TableType[]
  layoutTemplates LayoutTemplate[]
  weddings        Wedding[]
  decorItems      DecorItem[]
  createdAt       DateTime         @default(now())
}

model TableType {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name      String
  shape     String // "round" | "rect"
  minSeats  Int
  maxSeats  Int
  width     Float // metres
  depth     Float // metres
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
}

model LayoutTemplate {
  id          String          @id @default(cuid())
  venueId     String
  venue       Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  floorPlanId String?
  floorPlan   FloorPlan?      @relation(fields: [floorPlanId], references: [id])
  name        String
  minGuests   Int
  maxGuests   Int
  lines       String? // JSON: { tableTypeId: string; quantity: number }[] (legacy/optional)
  photos      String? // JSON array of Supabase Storage object paths — example photos of this setup, shown to couples when picking a base template
  tables      Table[]
  moments     WeddingMoment[]
  createdAt   DateTime        @default(now())
}

model FloorPlan {
  id             String           @id @default(cuid())
  venueId        String
  venue          Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name           String? // human label for the layout (e.g. "Salão principal")
  image          String // local file path
  scale          Float // pixels per metre
  width          Float // metres
  depth          Float // metres
  minSpacing     Float? // metres, minimum clearance between tables
  boundary       String? // JSON array of {x,y} points, natural pixels
  zones          String? // JSON, zone definitions
  elements       String? // JSON array of {id,x,y,w,h,label,color} decorative room fixtures (dance floor, bar, ...)
  tables         Table[]
  templates      LayoutTemplate[]
  weddings       Wedding[]
  moments        WeddingMoment[]
  weddingLayouts WeddingLayout[]
  createdAt      DateTime         @default(now())
}

model Table {
  id              String          @id @default(cuid())
  floorPlanId     String?
  floorPlan       FloorPlan?      @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  templateId      String?
  template        LayoutTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  weddingId       String?
  wedding         Wedding?        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  // A couple-owned layout's tables live here (the new multi-layout model). The
  // legacy `weddingId` copy stays for the single-arrangement flow until it's
  // fully migrated onto layouts (Wave 4). Exactly one parent FK is set.
  weddingLayoutId String?
  weddingLayout   WeddingLayout?  @relation(fields: [weddingLayoutId], references: [id], onDelete: Cascade)
  layoutSeats     LayoutSeat[]
  shape           String // "round" | "rect"
  capacity        Int
  width           Float? // metres
  depth           Float? // metres
  minCapacity     Int?
  x               Float
  y               Float
  fixed           Boolean         @default(false)
  name            String? // optional human label ("Mesa dos noivos"); falls back to "Mesa N" when unset
  heads           Boolean?        @default(true) // rect tables only: seats on the two short ends ("cabeceiras")
}

model Wedding {
  id            String               @id @default(cuid())
  couple        String
  date          DateTime?
  venueId       String?
  venue         Venue?               @relation(fields: [venueId], references: [id])
  ownerId       String? // Profile.id of the couple account — nullable (a venue may create the wedding first)
  partner1      String?
  partner1Email String?
  partner1Phone String?
  partner2      String?
  partner2Email String?
  partner2Phone String?
  guestEstimate Int?
  notes         String?
  floorPlanId   String?
  floorPlan     FloorPlan?           @relation(fields: [floorPlanId], references: [id])
  templateId    String?
  tables        Table[]
  guests        Guest[]
  groups        Group[]
  constraints   Constraint[]
  moments       WeddingMoment[]
  invites       WeddingInvite[]
  layouts       WeddingLayout[]
  suppliers     Supplier[]
  participants  WeddingParticipant[]
  services      WeddingService[]
  requirements  WeddingRequirement[]
  auditEvents   AuditEvent[]
  createdAt     DateTime             @default(now())
}

/// Append-only activity/audit log — the immutable record of every meaningful
/// change and interaction on a wedding. It is the "Atividade" tab, the "never
/// lose information" guarantee (old values kept in `changes`), and the seed for
/// notifications. Written ONLY via `recordEvent` (server-side, after a mutation
/// succeeds); never edited or deleted (except cascade with the wedding). Scoped
/// reads: venue/couple see all; a supplier sees events they authored or that
/// concern their slot (`supplierId`). See `src/lib/db/audit.ts`.
model AuditEvent {
  id             String   @id @default(cuid())
  weddingId      String
  wedding        Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  actorProfileId String? // who did it (Profile.id); null for system events
  actorRole      String // "venue" | "couple" | "supplier" | "admin" (denormalized for display/filter)
  actorLabel     String // display snapshot (name/email) — survives account/slot deletion
  action         String // dot-namespaced verb, e.g. "requirement.status_changed"
  entityType     String // "requirement" | "service" | "task" | "invite" | "layout" | …
  entityId       String?
  summary        String // human PT sentence, e.g. "Catering pediu: 8 mesas + 12 m lineares"
  supplierId     String? // the supplier slot the event concerns (for scoped supplier visibility)
  changes        Json? // { field: { from, to }, … } — the lossless before/after diffs
  createdAt      DateTime @default(now())

  @@index([weddingId, createdAt])
  @@index([supplierId])
}

/// The responsibility matrix of a wedding: which services it needs (catering, DJ,
/// decoração…) and WHO provides each — the venue in-house (`venue`, using its own
/// catalog/team), an external supplier slot (`supplier`), or the couple (`couple`).
/// This is what generalizes the platform: decoration may be venue-provided at one
/// venue and an external decorator at another. Drives the venue's coordination UI
/// and (later) which requirements/interactions belong to whom. Venue-managed.
model WeddingService {
  id           String    @id @default(cuid())
  weddingId    String
  wedding      Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  kind         String // catering | dj | band | photo | video | decor | flowers | cake | transport | other
  name         String? // optional label; falls back to the kind's default label
  providerType String    @default("venue") // "venue" | "supplier" | "couple"
  supplierId   String? // the Supplier slot, when providerType == "supplier"
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  status       String    @default("planned") // "planned" | "confirmed" | "done"
  note         String?
  createdAt    DateTime  @default(now())
  requirements WeddingRequirement[]

  @@index([weddingId])
  @@index([supplierId])
}

/// The interactions ledger — the single source of truth for structured needs and
/// agreements between the parties of a wedding. A requirement is RAISED by one
/// participant (`fromRole`/`fromProfileId`) and optionally ADDRESSED to another
/// (`toRole`, or a specific supplier slot `toSupplierId`), optionally tied to a
/// moment and/or a matrix service. It has a lifecycle everyone relevant can see:
/// open → agreed → done. Examples: catering→venue "cocktail: 8 mesas + 12 m
/// lineares"; venue→DJ "zona de montagem + 3 tomadas". Visibility is scoped in
/// `assertRequirementAccess`: venue/couple see all; a supplier sees only the ones
/// they raised, that target their slot, or that concern a service they provide.
model WeddingRequirement {
  id            String          @id @default(cuid())
  weddingId     String
  wedding       Wedding         @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  momentId      String?
  moment        WeddingMoment?  @relation(fields: [momentId], references: [id], onDelete: SetNull)
  serviceId     String?
  service       WeddingService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  fromRole      String // "venue" | "couple" | "supplier" — who raised it
  fromProfileId String? // the raising account (attribution)
  toRole        String? // "venue" | "couple" | "supplier" — who it's addressed to
  toSupplierId  String? // a specific supplier slot, when addressed to one
  title         String
  detail        String? // free text; can hold structured content ("8 mesas, 12 m lineares")
  data          Json? // optional structured fields, e.g. { tables, linearMeters, time } — the venue reads exact numbers, no parsing
  status        String          @default("open") // "open" (aberto) | "agreed" (acordado) | "done" (feito)
  // Handshake: "agreed" is set by the COUNTERPART (never the raiser). Editing an
  // agreed requirement auto-reopens it (these are cleared), so an agreement can't
  // be silently altered. This is the immutable "who agreed, when" trail.
  agreedByProfileId String?
  agreedByRole      String? // "venue" | "couple" | "supplier" — who confirmed
  agreedAt          DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  comments      WeddingRequirementComment[]

  @@index([weddingId])
  @@index([serviceId])
  @@index([toSupplierId])
}

/// A lightweight reply on a requirement — the two-way communication layer of the
/// ledger. Author is a participant (`authorRole`/`authorProfileId`).
model WeddingRequirementComment {
  id              String             @id @default(cuid())
  requirementId   String
  requirement     WeddingRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  authorRole      String // "venue" | "couple" | "supplier"
  authorProfileId String?
  text            String
  createdAt       DateTime           @default(now())

  @@index([requirementId])
}

/// A couple-owned room layout: a base (a venue template's floor plan as read-only
/// background, OR a blank room defined by width/depth/scale) + its own set of
/// tables + its own seating (LayoutSeat). A wedding can have several; exactly one
/// is `isFinal` (drives the venue progress view, the Visão geral, and the PDF).
/// The guest list is shared at the wedding level — only tables + seating differ
/// per layout, so a guest can sit at different tables across layouts.
model WeddingLayout {
  id          String         @id @default(cuid())
  weddingId   String
  wedding     Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  // A layout now belongs to a MOMENT (the room arrangement of that moment). A
  // moment can have several; exactly one is `isFinal` PER MOMENT. `weddingId` is
  // kept (populated from the moment) for tenancy + shared-guest resolution.
  momentId    String?
  moment      WeddingMoment? @relation(fields: [momentId], references: [id], onDelete: Cascade)
  name        String
  isFinal     Boolean        @default(false)
  // Background source: EITHER a venue template's floor plan (read-only render
  // source — image/scale/zones/elements) …
  floorPlanId String?
  floorPlan   FloorPlan?     @relation(fields: [floorPlanId], references: [id])
  templateId  String? // provenance: the template it was created from (informational)
  // … OR a blank room the couple defined by dimensions (no floorPlanId).
  width       Float? // metres
  depth       Float? // metres
  scale       Float? // pixels per metre
  // Generic decorative rectangles the couple places (bar, pista de dança, ...) —
  // same JSON shape as FloorPlan.elements. Seeded from the template's floor plan
  // on creation-from-template; editable in the couple's layout editor.
  elements    String?
  tables      Table[]
  seats       LayoutSeat[]
  createdAt   DateTime       @default(now())

  @@index([weddingId])
}

/// A guest's seat within one couple layout. Per-layout (unlike the legacy single
/// `Guest.assignedTableId`): a guest has at most one seat per layout. Absent row
/// = unseated in that layout. Both FKs cascade — removing a table or a guest
/// drops the seat automatically.
model LayoutSeat {
  id              String        @id @default(cuid())
  weddingLayoutId String
  weddingLayout   WeddingLayout @relation(fields: [weddingLayoutId], references: [id], onDelete: Cascade)
  guestId         String
  guest           Guest         @relation(fields: [guestId], references: [id], onDelete: Cascade)
  tableId         String
  table           Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([weddingLayoutId, guestId])
  @@index([weddingLayoutId])
}

/// Invites a couple/venue account to a Wedding they don't yet own an account
/// for (issue/accept endpoints land in Fase E — this is just the data model).
model WeddingInvite {
  id           String   @id @default(cuid())
  weddingId    String
  wedding      Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  email        String
  token        String   @unique
  role         String // "venue" | "couple" | "supplier"
  supplierId   String? // the supplier slot this invite is for (when role == "supplier")
  service      String? // supplier service kind (informational)
  acceptedById String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

/// Who takes part in a wedding and as what — the single place access resolves
/// "is this actor a participant of THIS wedding, and in which role?". The venue
/// owner, the couple, and each supplier account are participant rows. Backfilled
/// for existing weddings from Venue.ownerId (venue) + Wedding.ownerId (couple).
model WeddingParticipant {
  id         String   @id @default(cuid())
  weddingId  String
  wedding    Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  profileId  String // Profile.id (plain string, like Venue.ownerId — auth.users lives outside Prisma)
  role       String // "venue" | "couple" | "supplier"
  supplierId String? // the Supplier slot, when role == "supplier"
  createdAt  DateTime @default(now())
  // When this participant last opened the activity log — drives the "novidades"
  // (unseen) badge. Null = never opened (everything is new).
  lastSeenActivityAt DateTime?

  @@unique([weddingId, profileId])
  @@index([weddingId])
  @@index([profileId])
}

/// A moment in the wedding day (cerimónia, cocktail, jantar, dança, or a custom
/// one the couple adds). Dynamic now: the 4 defaults are seeded on wedding
/// creation with a `kind` tag + `title`/`order`, but the couple can add/remove/
/// rename/reorder freely, so identity is `id` (not the old (weddingId,kind)
/// unique). Each moment keeps a venue arrangement VIEW (`templateId`) and gains a
/// decoration list + a task list.
model WeddingMoment {
  id          String           @id @default(cuid())
  weddingId   String
  wedding     Wedding          @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  kind        String? // tag for the seeded defaults (ceremony|cocktail|dinner|dance); null for custom
  title       String? // display name; falls back to the kind label when null
  order       Int              @default(0)
  startTime   String? // planned start time of day, "HH:MM" (drives the chronological Visão geral + durations)
  // Whether this moment has a SEATING plan (assigned seats) — typically only the
  // dinner. When false, its layouts are arrangements (tables + elements) with no
  // seated guests.
  hasSeating  Boolean          @default(false)
  floorPlanId String?
  floorPlan   FloorPlan?       @relation(fields: [floorPlanId], references: [id])
  templateId  String?
  template    LayoutTemplate?  @relation(fields: [templateId], references: [id])
  notes       String? // legacy free-text (superseded by tasks); kept, unused by new UI
  tasks        MomentTask[]
  decor        MomentDecor[]
  layouts      WeddingLayout[]
  materials    MomentMaterial[]
  requirements WeddingRequirement[]

  @@index([weddingId])
}

/// Extra operational material the VENUE needs for a moment (e.g. "tomadas triplas
/// para o DJ) — added by the venue, visible ONLY to the venue (never the couple).
/// Distinct from decoration (which the couple picks).
model MomentMaterial {
  id        String        @id @default(cuid())
  momentId  String
  moment    WeddingMoment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  name      String
  quantity  Int           @default(1)
  note      String?
  createdAt DateTime      @default(now())

  @@index([momentId])
}

/// A supplier/vendor for a wedding (catering, fotografia, DJ, ...). Wedding-owned;
/// added on the Detalhes page. Assignable as the responsible party of a task.
/// A supplier/vendor SLOT on a wedding (catering, DJ, foto, decoração, banda…).
/// Doubles as the invitable participant: the venue adds the slot, invites it
/// (`inviteToken`), and once a supplier account accepts, `profileId` links their
/// Profile (see WeddingParticipant). Still assignable as a task's responsible party.
model Supplier {
  id          String       @id @default(cuid())
  weddingId   String
  wedding     Wedding      @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  name        String
  service     String? // what they provide (free text or a kind: catering|dj|photo|decor|band|other)
  contact     String? // phone/email/note
  email       String? // invite email
  profileId   String? // Profile.id of the linked supplier account (after accepting), if any
  inviteToken String? // token for the shareable invite link (random, app-unique)
  invitedAt   DateTime?
  acceptedAt  DateTime?
  createdAt   DateTime     @default(now())
  tasks       MomentTask[]
  services    WeddingService[]

  @@index([weddingId])
  @@index([profileId])
  @@index([inviteToken])
}

/// A to-do / pending item within a moment, assignable to the couple, the venue,
/// or a specific supplier (`assignee` + `supplierId`).
model MomentTask {
  id         String        @id @default(cuid())
  momentId   String
  moment     WeddingMoment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  text       String
  note       String? // free-text notes about the task
  done       Boolean       @default(false)
  assignee   String        @default("couple") // "couple" | "venue" | "supplier"
  supplierId String? // set when assignee == "supplier"
  supplier   Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  dueDate    DateTime?
  order      Int           @default(0)
  createdAt  DateTime      @default(now())

  @@index([momentId])
}

/// A decoration line on a moment: either references a venue catalog item
/// (`decorItemId`) or is the couple's own custom item (`name`/`note` when the ref
/// is null). `quantity` applies to both.
model MomentDecor {
  id          String        @id @default(cuid())
  momentId    String
  moment      WeddingMoment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  decorItemId String? // from the venue's catalog; null => custom item
  decorItem   DecorItem?    @relation(fields: [decorItemId], references: [id], onDelete: SetNull)
  name        String? // custom item name (when decorItemId is null)
  note        String?
  quantity    Int           @default(1)
  createdAt   DateTime      @default(now())

  @@index([momentId])
}

/// The venue's decoration catalog (dataset). Venue-owned; the couple picks items
/// from it per moment (and may also add their own custom MomentDecor lines).
model DecorItem {
  id          String        @id @default(cuid())
  venueId     String
  venue       Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name        String
  category    String?
  image       String? // optional Supabase Storage object path
  price       Float?
  quantity    Int? // how many the venue has available (informational)
  createdAt   DateTime      @default(now())
  momentDecor MomentDecor[]

  @@index([venueId])
}

model Group {
  id        String  @id @default(cuid())
  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  guests    Guest[]
}

model Guest {
  id              String       @id @default(cuid())
  weddingId       String
  wedding         Wedding      @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  name            String
  groupId         String?
  group           Group?       @relation(fields: [groupId], references: [id])
  extraGroups     String?
  assignedTableId String?
  locked          Boolean      @default(false)
  ageGroup        String?
  gender          String?
  dietary         String?
  rsvp            String?      @default("pending")
  plusOneId       String?      @unique
  plusOne         Guest?       @relation("PlusOne", fields: [plusOneId], references: [id], onDelete: SetNull)
  plusOneOf       Guest?       @relation("PlusOne")
  layoutSeats     LayoutSeat[]
}

model Constraint {
  id        String  @id @default(cuid())
  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  type      String // "together" | "separate"
  guestAId  String
  guestBId  String
}
