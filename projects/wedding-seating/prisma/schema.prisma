generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; "rhel-openssl-3.0.x" for Vercel's serverless runtime (Fase A).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Mirrors a Supabase `auth.users` row (id = same uuid). Not a Prisma relation
/// to auth.users — that schema lives outside Prisma's reach. Created/upserted
/// right after signup/login (see `src/lib/db/profiles.ts`).
model Profile {
  id        String   @id // Supabase auth.users.id (uuid)
  email     String
  role      String // "venue" | "couple" | "admin"
  createdAt DateTime @default(now())
}

model Venue {
  id              String           @id @default(cuid())
  name            String
  location        String?
  photos          String? // JSON array of file paths
  ownerId         String? // Profile.id of the venue account — nullable until Fase D tightens + filters
  floorPlans      FloorPlan[]
  tableTypes      TableType[]
  layoutTemplates LayoutTemplate[]
  weddings        Wedding[]
  decorItems      DecorItem[]
  createdAt       DateTime         @default(now())
}

model TableType {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name      String
  shape     String // "round" | "rect"
  minSeats  Int
  maxSeats  Int
  width     Float // metres
  depth     Float // metres
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
}

model LayoutTemplate {
  id          String          @id @default(cuid())
  venueId     String
  venue       Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  floorPlanId String?
  floorPlan   FloorPlan?      @relation(fields: [floorPlanId], references: [id])
  name        String
  minGuests   Int
  maxGuests   Int
  lines       String? // JSON: { tableTypeId: string; quantity: number }[] (legacy/optional)
  photos      String? // JSON array of Supabase Storage object paths — example photos of this setup, shown to couples when picking a base template
  tables      Table[]
  moments     WeddingMoment[]
  createdAt   DateTime        @default(now())
}

model FloorPlan {
  id             String           @id @default(cuid())
  venueId        String
  venue          Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name           String? // human label for the layout (e.g. "Salão principal")
  image          String // local file path
  scale          Float // pixels per metre
  width          Float // metres
  depth          Float // metres
  minSpacing     Float? // metres, minimum clearance between tables
  boundary       String? // JSON array of {x,y} points, natural pixels
  zones          String? // JSON, zone definitions
  elements       String? // JSON array of {id,x,y,w,h,label,color} decorative room fixtures (dance floor, bar, ...)
  tables         Table[]
  templates      LayoutTemplate[]
  weddings       Wedding[]
  moments        WeddingMoment[]
  weddingLayouts WeddingLayout[]
  createdAt      DateTime         @default(now())
}

model Table {
  id              String          @id @default(cuid())
  floorPlanId     String?
  floorPlan       FloorPlan?      @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  templateId      String?
  template        LayoutTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  weddingId       String?
  wedding         Wedding?        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  // A couple-owned layout's tables live here (the new multi-layout model). The
  // legacy `weddingId` copy stays for the single-arrangement flow until it's
  // fully migrated onto layouts (Wave 4). Exactly one parent FK is set.
  weddingLayoutId String?
  weddingLayout   WeddingLayout?  @relation(fields: [weddingLayoutId], references: [id], onDelete: Cascade)
  layoutSeats     LayoutSeat[]
  shape           String // "round" | "rect"
  capacity        Int
  width           Float? // metres
  depth           Float? // metres
  minCapacity     Int?
  x               Float
  y               Float
  fixed           Boolean         @default(false)
  name            String? // optional human label ("Mesa dos noivos"); falls back to "Mesa N" when unset
  heads           Boolean?        @default(true) // rect tables only: seats on the two short ends ("cabeceiras")
}

model Wedding {
  id            String          @id @default(cuid())
  couple        String
  date          DateTime?
  venueId       String?
  venue         Venue?          @relation(fields: [venueId], references: [id])
  ownerId       String? // Profile.id of the couple account — nullable (a venue may create the wedding first)
  partner1      String?
  partner1Email String?
  partner1Phone String?
  partner2      String?
  partner2Email String?
  partner2Phone String?
  guestEstimate Int?
  notes         String?
  floorPlanId   String?
  floorPlan     FloorPlan?      @relation(fields: [floorPlanId], references: [id])
  templateId    String?
  tables        Table[]
  guests        Guest[]
  groups        Group[]
  constraints   Constraint[]
  moments       WeddingMoment[]
  invites       WeddingInvite[]
  layouts       WeddingLayout[]
  suppliers     Supplier[]
  createdAt     DateTime        @default(now())
}

/// A couple-owned room layout: a base (a venue template's floor plan as read-only
/// background, OR a blank room defined by width/depth/scale) + its own set of
/// tables + its own seating (LayoutSeat). A wedding can have several; exactly one
/// is `isFinal` (drives the venue progress view, the Visão geral, and the PDF).
/// The guest list is shared at the wedding level — only tables + seating differ
/// per layout, so a guest can sit at different tables across layouts.
model WeddingLayout {
  id          String         @id @default(cuid())
  weddingId   String
  wedding     Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  // A layout now belongs to a MOMENT (the room arrangement of that moment). A
  // moment can have several; exactly one is `isFinal` PER MOMENT. `weddingId` is
  // kept (populated from the moment) for tenancy + shared-guest resolution.
  momentId    String?
  moment      WeddingMoment? @relation(fields: [momentId], references: [id], onDelete: Cascade)
  name        String
  isFinal     Boolean        @default(false)
  // Background source: EITHER a venue template's floor plan (read-only render
  // source — image/scale/zones/elements) …
  floorPlanId String?
  floorPlan   FloorPlan?     @relation(fields: [floorPlanId], references: [id])
  templateId  String? // provenance: the template it was created from (informational)
  // … OR a blank room the couple defined by dimensions (no floorPlanId).
  width       Float? // metres
  depth       Float? // metres
  scale       Float? // pixels per metre
  // Generic decorative rectangles the couple places (bar, pista de dança, ...) —
  // same JSON shape as FloorPlan.elements. Seeded from the template's floor plan
  // on creation-from-template; editable in the couple's layout editor.
  elements    String?
  tables      Table[]
  seats       LayoutSeat[]
  createdAt   DateTime       @default(now())

  @@index([weddingId])
}

/// A guest's seat within one couple layout. Per-layout (unlike the legacy single
/// `Guest.assignedTableId`): a guest has at most one seat per layout. Absent row
/// = unseated in that layout. Both FKs cascade — removing a table or a guest
/// drops the seat automatically.
model LayoutSeat {
  id              String        @id @default(cuid())
  weddingLayoutId String
  weddingLayout   WeddingLayout @relation(fields: [weddingLayoutId], references: [id], onDelete: Cascade)
  guestId         String
  guest           Guest         @relation(fields: [guestId], references: [id], onDelete: Cascade)
  tableId         String
  table           Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([weddingLayoutId, guestId])
  @@index([weddingLayoutId])
}

/// Invites a couple/venue account to a Wedding they don't yet own an account
/// for (issue/accept endpoints land in Fase E — this is just the data model).
model WeddingInvite {
  id           String   @id @default(cuid())
  weddingId    String
  wedding      Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  email        String
  token        String   @unique
  role         String // "venue" | "couple"
  acceptedById String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

/// A moment in the wedding day (cerimónia, cocktail, jantar, dança, or a custom
/// one the couple adds). Dynamic now: the 4 defaults are seeded on wedding
/// creation with a `kind` tag + `title`/`order`, but the couple can add/remove/
/// rename/reorder freely, so identity is `id` (not the old (weddingId,kind)
/// unique). Each moment keeps a venue arrangement VIEW (`templateId`) and gains a
/// decoration list + a task list.
model WeddingMoment {
  id          String           @id @default(cuid())
  weddingId   String
  wedding     Wedding          @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  kind        String? // tag for the seeded defaults (ceremony|cocktail|dinner|dance); null for custom
  title       String? // display name; falls back to the kind label when null
  order       Int              @default(0)
  startTime   String? // planned start time of day, "HH:MM" (drives the chronological Visão geral + durations)
  // Whether this moment has a SEATING plan (assigned seats) — typically only the
  // dinner. When false, its layouts are arrangements (tables + elements) with no
  // seated guests.
  hasSeating  Boolean          @default(false)
  floorPlanId String?
  floorPlan   FloorPlan?       @relation(fields: [floorPlanId], references: [id])
  templateId  String?
  template    LayoutTemplate?  @relation(fields: [templateId], references: [id])
  notes       String? // legacy free-text (superseded by tasks); kept, unused by new UI
  tasks       MomentTask[]
  decor       MomentDecor[]
  layouts     WeddingLayout[]
  materials   MomentMaterial[]

  @@index([weddingId])
}

/// Extra operational material the VENUE needs for a moment (e.g. "tomadas triplas
/// para o DJ) — added by the venue, visible ONLY to the venue (never the couple).
/// Distinct from decoration (which the couple picks).
model MomentMaterial {
  id        String        @id @default(cuid())
  momentId  String
  moment    WeddingMoment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  name      String
  quantity  Int           @default(1)
  note      String?
  createdAt DateTime      @default(now())

  @@index([momentId])
}

/// A supplier/vendor for a wedding (catering, fotografia, DJ, ...). Wedding-owned;
/// added on the Detalhes page. Assignable as the responsible party of a task.
model Supplier {
  id        String       @id @default(cuid())
  weddingId String
  wedding   Wedding      @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  name      String
  service   String? // what they provide (free text)
  contact   String? // phone/email/note
  createdAt DateTime     @default(now())
  tasks     MomentTask[]

  @@index([weddingId])
}

/// A to-do / pending item within a moment, assignable to the couple, the venue,
/// or a specific supplier (`assignee` + `supplierId`).
model MomentTask {
  id         String        @id @default(cuid())
  momentId   String
  moment     WeddingMoment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  text       String
  note       String? // free-text notes about the task
  done       Boolean       @default(false)
  assignee   String        @default("couple") // "couple" | "venue" | "supplier"
  supplierId String? // set when assignee == "supplier"
  supplier   Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  dueDate    DateTime?
  order      Int           @default(0)
  createdAt  DateTime      @default(now())

  @@index([momentId])
}

/// A decoration line on a moment: either references a venue catalog item
/// (`decorItemId`) or is the couple's own custom item (`name`/`note` when the ref
/// is null). `quantity` applies to both.
model MomentDecor {
  id          String        @id @default(cuid())
  momentId    String
  moment      WeddingMoment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  decorItemId String? // from the venue's catalog; null => custom item
  decorItem   DecorItem?    @relation(fields: [decorItemId], references: [id], onDelete: SetNull)
  name        String? // custom item name (when decorItemId is null)
  note        String?
  quantity    Int           @default(1)
  createdAt   DateTime      @default(now())

  @@index([momentId])
}

/// The venue's decoration catalog (dataset). Venue-owned; the couple picks items
/// from it per moment (and may also add their own custom MomentDecor lines).
model DecorItem {
  id          String        @id @default(cuid())
  venueId     String
  venue       Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name        String
  category    String?
  image       String? // optional Supabase Storage object path
  price       Float?
  quantity    Int? // how many the venue has available (informational)
  createdAt   DateTime      @default(now())
  momentDecor MomentDecor[]

  @@index([venueId])
}

model Group {
  id        String  @id @default(cuid())
  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  guests    Guest[]
}

model Guest {
  id              String       @id @default(cuid())
  weddingId       String
  wedding         Wedding      @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  name            String
  groupId         String?
  group           Group?       @relation(fields: [groupId], references: [id])
  extraGroups     String?
  assignedTableId String?
  locked          Boolean      @default(false)
  ageGroup        String?
  gender          String?
  dietary         String?
  rsvp            String?      @default("pending")
  plusOneId       String?      @unique
  plusOne         Guest?       @relation("PlusOne", fields: [plusOneId], references: [id], onDelete: SetNull)
  plusOneOf       Guest?       @relation("PlusOne")
  layoutSeats     LayoutSeat[]
}

model Constraint {
  id        String  @id @default(cuid())
  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  type      String // "together" | "separate"
  guestAId  String
  guestBId  String
}
